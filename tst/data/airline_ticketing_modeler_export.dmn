  <dmn:decision id="_F671F952-7E2B-44AC-B32E-F2090196C678" name="BaggageFee">
    <dmn:extensionElements/>
    <dmn:variable id="_13D4BDAF-2429-4F23-AC4D-B8E2101DAF35" name="BaggageFee" typeRef="number"/>
    <dmn:informationRequirement id="_375A651A-EE58-4FBF-A4D9-FCB60144244A">
      <dmn:requiredInput href="#_16E58A42-C8B3-4F5E-9BE3-D3405688D721"/>
    </dmn:informationRequirement>
    <dmn:literalExpression id="_89A03372-788E-4724-A8B8-18AAC66D9D4C">
      <dmn:text>if BaggageCount &lt;= 1 then 0
else if BaggageCount = 2 then 30
else 30 + (BaggageCount - 2) * 50</dmn:text>
    </dmn:literalExpression>
  </dmn:decision>
